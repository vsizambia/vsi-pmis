generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Role {
  id String @id @default(cuid())

  code        String  @unique
  name        String  @unique
  description String?

  isSystem Boolean @default(false)
  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users User[]
}

model Directorate {
  id String @id @default(cuid())

  code        String  @unique
  name        String  @unique
  description String?

  displayOrder Int     @default(1)
  isActive     Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users      User[]
  programmes Programme[]
}

model User {
  id String @id @default(cuid())

  name     String
  email    String @unique
  password String

  designation String?
  phone       String?

  isActive Boolean @default(true)

  roleId        String
  directorateId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  role        Role         @relation(fields: [roleId], references: [id])
  directorate Directorate? @relation(fields: [directorateId], references: [id])

  managedProjects Project[] @relation("ProjectManager")
}

model Programme {
  id          String  @id @default(cuid())
  name        String  @unique
  description String?

  startYear Int
  endYear   Int

  directorateId String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  directorate Directorate @relation(fields: [directorateId], references: [id], onDelete: Cascade)

  projects   Project[]
  indicators Indicator[]
}

model Project {
  id          String  @id @default(cuid())
  name        String  @unique
  description String?

  startDate DateTime?
  endDate   DateTime?

  status String @default("Planned")

  budget   Float?
  currency String @default("ZMW")

  programmeId      String
  projectManagerId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  programme      Programme @relation(fields: [programmeId], references: [id], onDelete: Cascade)
  projectManager User?     @relation("ProjectManager", fields: [projectManagerId], references: [id])

  activities    Activity[]
  beneficiaries Beneficiary[]
  locations     ProjectLocation[]
}

model ProjectLocation {
  id String @id @default(cuid())

  projectId String

  country  String
  province String
  district String

  createdAt DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model Beneficiary {
  id String @id @default(cuid())

  projectId String

  gender   String
  age      Int
  ageGroup String

  number Int @default(1)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model Activity {
  id String @id @default(cuid())

  title       String
  description String?

  projectId String

  startDate DateTime?
  endDate   DateTime?

  status String @default("Planned")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model Indicator {
  id String @id @default(cuid())

  name String @unique

  baseline String?
  target   String?
  achieved String?

  programmeId String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  programme Programme @relation(fields: [programmeId], references: [id], onDelete: Cascade)
}
