generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  password  String
  roleId    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  role      Role     @relation(fields: [roleId], references: [id])
}

model Role {
  id    String @id @default(cuid())
  name  String @unique
  users User[]
}

model Directorate {
  id          String      @id @default(cuid())
  name        String
  description String?
  createdAt   DateTime    @default(now())
  programmes  Programme[]
}

model Programme {
  id            String      @id @default(cuid())
  name          String
  description   String?
  startYear     Int
  endYear       Int
  directorateId String
  createdAt     DateTime    @default(now())
  indicators    Indicator[]
  directorate   Directorate @relation(fields: [directorateId], references: [id])
  projects      Project[]
}

model Project {
  id          String     @id @default(cuid())
  name        String
  description String?
  startDate   DateTime
  endDate     DateTime
  status      String
  programmeId String
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  activities  Activity[]
  programme   Programme  @relation(fields: [programmeId], references: [id])
}

model Activity {
  id           String   @id @default(cuid())
  name         String
  description  String?
  activityDate DateTime
  location     String?
  projectId    String
  createdAt    DateTime @default(now())
  project      Project  @relation(fields: [projectId], references: [id])
}

model Indicator {
  id          String    @id @default(cuid())
  name        String
  baseline    String?
  target      String?
  achieved    String?
  programmeId String
  createdAt   DateTime  @default(now())
  programme   Programme @relation(fields: [programmeId], references: [id])
}
